# Only for building the site somewhere other than GitHub Pages (a local preview, or Cloudflare Pages
# previews of branches). It pins the same Jekyll and plugins GitHub Pages uses, so a preview looks like
# the live site. GitHub Pages itself ignores this file.
source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick"   # Ruby 3 no longer bundles it; `jekyll serve` needs it
